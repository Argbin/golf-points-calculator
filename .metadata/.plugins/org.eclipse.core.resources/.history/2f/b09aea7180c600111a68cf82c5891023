/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void) {

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* MCU Configuration--------------------------------------------------------*/

	/* Reset of all peripherals, Initializes the Flash interface and the Systick. */
	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* Configure the system clock */
	SystemClock_Config();

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_USART2_UART_Init();
	MX_TIM2_Init();
	MX_SPI2_Init();
	/* USER CODE BEGIN 2 */
	HAL_GPIO_WritePin(SMPS_EN_GPIO_Port, SMPS_EN_Pin, GPIO_PIN_SET);
	HAL_Delay(50);

	HAL_TIM_Encoder_Start(&htim2, TIM_CHANNEL_ALL);

	//Initialize display.
	DEV_Module_Init();
	EPD_2in13_V4_Init();
	EPD_2in13_V4_Clear();
	HAL_Delay(500);

	//Configure and clear paint buffer
	Paint_NewImage(ImageBuffer, EPD_2in13_V4_WIDTH, EPD_2in13_V4_HEIGHT,
			ROTATE_90, WHITE);
	Paint_SelectImage(ImageBuffer);
	Paint_Clear(WHITE);

	/* USER CODE END 2 */

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {
		//Logic for encoder interrupt.
		uint32_t now;

		//Logic to get encoder value between 0-54.
		int32_t raw_count = (int32_t) TIM2->CNT;
		if (raw_count < 0) {
			TIM2->CNT = 0;
			encoder_value = 0;
		} else if (raw_count > (54 * 4 + 3)) {
			TIM2->CNT = (54 * 4 + 3);
			encoder_value = 54;
		} else {
			encoder_value = raw_count / 4;
		}

		if (last_flank_causing_exti != last_managed_exti) {	//If button has been pressed.
			now = HAL_GetTick();
			if (now - last_flank_causing_exti >= 20) {//Delay to eliminate contact bounce.
				last_managed_exti = last_flank_causing_exti;
				//What happens when the button is pressed.
				Paint_ClearWindows(10, 40, 74, 64, WHITE);
				Paint_DrawNum(10, 40, encoder_value, &Font16, WHITE, BLACK);//Draw value.
				EPD_2in13_V4_Display_Partial(ImageBuffer);	//Send data to display.
				EPD_2in13_V4_Display_Partial(ImageBuffer);
			}
		}
		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */
	}
	/* USER CODE END 3 */
}

